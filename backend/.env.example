# Database connection string — replace with your actual PostgreSQL URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/splitnest"

# JWT secret — used to sign authentication tokens
# In production, use a long random string. This is a dev placeholder.
JWT_SECRET="dev-secret-change-in-production"

# Server port
PORT=3001
